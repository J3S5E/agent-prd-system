{
  "name": "prd-webserver",
  "version": "1.0.0",
  "type": "module",
  "description": "PRD Webserver with Dashboard - Ticket lifecycle management, validation orchestration, and real-time Kanban dashboard",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run build:dashboard",
    "build:dashboard": "node -e \"const fs=require('fs'); fs.copyFileSync('src/dashboard/public/index.html','dist/dashboard/public/index.html'); fs.copyFileSync('src/dashboard/public/style.css','dist/dashboard/public/style.css');\"",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --reporter=verbose",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "dependencies": {
    "@libsql/client": "^0.15.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "marked": "^18.1.0",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
